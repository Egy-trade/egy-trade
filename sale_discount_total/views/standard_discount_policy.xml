<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_standard_discount_policy" model="ir.ui.view">
        <field name="name">res.config.settings.standard.discount.policy</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='sale_management']/div[hasclass('o_settings_container')][2]" position="inside">
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="standard_discount_enabled"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="standard_discount_enabled"/>
                        <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." groups="base.group_multi_company"/>
                        <div class="text-muted">
                            Controls the ordinary Discount % on verified pricelist quotation lines.
                        </div>
                        <div class="content-group" attrs="{'invisible': [('standard_discount_enabled', '=', False)]}">
                            <div class="row mt16">
                                <label for="standard_discount_maximum" class="col-md-6 o_light_label"/>
                                <field name="standard_discount_maximum"/>
                            </div>
                            <div class="row mt16">
                                <label for="standard_discount_default_cap" class="col-md-6 o_light_label"/>
                                <field name="standard_discount_default_cap"/>
                            </div>
                            <div class="text-muted">
                                The company maximum is an absolute 30% ceiling. Personal caps can be lower.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_standard_discount_cap" model="ir.ui.view">
        <field name="name">res.users.form.standard.discount.cap</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Quotation Discount Authority"
                       groups="base.group_system,sales_team.group_sale_manager">
                    <field name="standard_discount_cap"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
