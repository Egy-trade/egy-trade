<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="sale_order_product_pricing_form" model="ir.ui.view">
            <field name="name">sale.order.product.pricing.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="can_edit_quotation_price" invisible="1"/>
                    <field name="can_assign_salesperson" invisible="1"/>
                    <field name="can_assign_quotation_specialist" invisible="1"/>
                    <field name="product_pricing"
                           groups="sale_order_product_pricing.product_pricing_group"
                           attrs="{'invisible': [('partner_id', '=', False)], 'readonly': [('state', '!=', 'draft')]}"/>
                </field>

                <!-- A sent quotation is an immutable client version.  These are
                     deliberately view guards too: the matching ORM guards remain
                     authoritative for RPC, imports, and alternate views. -->
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='date_order']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='validity_date']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='pricelist_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='payment_term_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='fiscal_position_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='incoterm']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='client_order_ref']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='note']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>

                <xpath expr="//field[@name='user_id']" position="attributes">
                    <attribute name="groups"/>
                    <attribute name="attrs">{'readonly': ['|', ('state', '!=', 'draft'),
                        ('can_assign_salesperson', '=', False)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="quotation_specialist_id"
                           groups="sale_order_product_pricing.quotation_specialist_group,sales_team.group_sale_manager"
                           attrs="{'readonly': ['|', ('state', '!=', 'draft'),
                               ('can_assign_quotation_specialist', '=', False)]}"/>
                </xpath>

                <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>

                <!-- Text plus icon and colour make the source intelligible without relying on colour. -->
                <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="after">
                    <field name="price_origin_display" string="Price Origin" widget="html" readonly="1"
                           optional="show" groups="sale_order_product_pricing.product_pricing_group"/>
                </xpath>

                <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="before">
                    <field name="can_edit_quoted_price" invisible="1"/>
                </xpath>

                <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="attributes">
                    <attribute name="attrs">{'readonly': ['|', ('parent.state', '!=', 'draft'), ('can_edit_quoted_price', '=', False)]}</attribute>
                </xpath>

                <xpath expr="//field[@name='order_line']/tree/field[@name='discount']" position="attributes">
                    <attribute name="attrs">{'readonly': ['|', ('parent.state', '!=', 'draft'), ('can_edit_quoted_price', '=', False)]}</attribute>
                </xpath>

                <xpath expr="//notebook/page[@name='customer_signature']" position="after">
                    <page string="Product Pricing" name="product_pricing"
                          groups="sale_order_product_pricing.product_pricing_group"
                          attrs="{'invisible': [('product_pricing', '=', False)]}">
                        <group>
                            <group>
                                <field name="change_currency_rate_type" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="change_currency_rate" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="global_factor" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                            <group>
                                <field name="currency_estimate_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="currency_rate_estimate" readonly="1"/>
                                <field name="currency_rate_inverse" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <button name="action_preview_product_pricing" type="object" string="Preview Product Pricing"
                                    class="btn-secondary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                            <button name="action_apply_product_pricing" type="object" string="Apply Product Pricing"
                                    class="btn-primary" confirm="Apply the reviewed Product Pricing proposal to this quotation?"
                                    context="{'pricing_apply_confirmed': True}"
                                    attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        </group>
                        <field name="order_line" nolabel="1"
                               domain="[('display_type', '=', False), ('is_downpayment', '=', False)]"
                               attrs="{'readonly': [('state', '!=', 'draft')]}">
                            <tree editable="bottom" create="0" delete="0">
                                <field name="product_id" readonly="1"/>
                                <field name="name" optional="hide"/>
                                <field name="product_uom_qty" string="Quantity" readonly="1"/>
                                <field name="product_uom" readonly="1" optional="hide"/>
                                <field name="purchase_price_estimate" string="Cost"/>
                                <field name="pricing_eligible" readonly="1"/>
                                <field name="pricing_warning" readonly="1" optional="show"/>
                                <field name="factor"/>
                                <field name="line_factor"/>
                                <field name="estimate_unit_price" string="Estimate" readonly="1"/>
                                <field name="price_reference" string="Reference" readonly="1"/>
                                <field name="price_unit" string="Quoted Price" readonly="1"/>
                                <field name="price_origin_display" string="Price Origin" widget="html" readonly="1"/>
                            </tree>
                        </field>
                        <group string="Price Origin Summary">
                            <field name="product_pricing_line_count" readonly="1"/>
                            <field name="odoo_pricelist_line_count" readonly="1"/>
                            <field name="edited_price_line_count" readonly="1"/>
                        </group>
                        <field name="pricing_audit_log_ids" nolabel="1" readonly="1">
                            <tree create="0" edit="0" delete="0">
                                <field name="event_date"/>
                                <field name="user_id"/>
                                <field name="product_id"/>
                                <field name="old_price"/>
                                <field name="old_currency_id" optional="hide"/>
                                <field name="new_price"/>
                                <field name="new_currency_id" optional="hide"/>
                                <field name="old_origin"/>
                                <field name="new_origin"/>
                                <field name="reason"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="sale_order_universal_discount_security" model="ir.ui.view">
            <field name="name">sale.order.universal.discount.pricing.security</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="universal_discount.ks_discount_sale_order_form_inherited"/>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <field name="ks_enable_discount" position="after">
                    <field name="can_edit_quotation_price" invisible="1"/>
                </field>
                <field name="ks_enable_discount" position="attributes">
                    <attribute name="attrs">{'readonly': ['|', ('state', '!=', 'draft'),
                        ('can_edit_quotation_price', '=', False)]}</attribute>
                </field>
                <field name="ks_global_discount_type" position="attributes">
                    <attribute name="attrs">{'invisible': [('ks_enable_discount', '!=', True)],
                        'readonly': ['|', '|', ('ks_enable_discount', '!=', True),
                                     ('state', '!=', 'draft'),
                                     ('can_edit_quotation_price', '=', False)]}</attribute>
                </field>
                <field name="ks_global_discount_rate" position="attributes">
                    <attribute name="attrs">{'invisible': [('ks_enable_discount', '!=', True)],
                        'readonly': ['|', '|', ('ks_enable_discount', '!=', True),
                                     ('state', '!=', 'draft'),
                                     ('can_edit_quotation_price', '=', False)]}</attribute>
                </field>
                <xpath expr="//field[@name='order_line']//tree//field[@name='discount_2']" position="before">
                    <field name="can_edit_quoted_price" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='order_line']//tree//field[@name='discount_2']" position="attributes">
                    <attribute name="attrs">{'readonly': ['|', ('parent.state', '!=', 'draft'),
                        ('can_edit_quoted_price', '=', False)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']//tree//field[@name='discount_3']" position="attributes">
                    <attribute name="attrs">{'readonly': ['|', ('parent.state', '!=', 'draft'),
                        ('can_edit_quoted_price', '=', False)]}</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
