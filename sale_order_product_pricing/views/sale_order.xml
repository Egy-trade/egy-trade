<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="sale_order_product_pricing_form" model="ir.ui.view">
            <field name="name">sale.order.product.pricing.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="can_edit_quotation_price" invisible="1"/>
                    <field name="can_assign_salesperson" invisible="1"/>
                    <field name="can_assign_quotation_specialist" invisible="1"/>
                </field>

                <!-- A sent quotation is an immutable client version.  These are
                     deliberately view guards too: the matching ORM guards remain
                     authoritative for RPC, imports, and alternate views. -->
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='date_order']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='validity_date']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='pricelist_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                    <attribute name="domain">[('active', '=', True)]</attribute>
                    <attribute name="help">Choose an active Sales Pricelist. Only lines with a verified Odoo Pricelist origin are refreshed; Product Pricing and Manual Price lines stay protected.</attribute>
                </xpath>
                <xpath expr="//field[@name='payment_term_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='fiscal_position_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='incoterm']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='client_order_ref']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='note']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>

                <xpath expr="//field[@name='user_id']" position="attributes">
                    <attribute name="groups"/>
                    <attribute name="attrs">{'readonly': ['|', ('state', '!=', 'draft'),
                        ('can_assign_salesperson', '=', False)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="quotation_specialist_id"
                           groups="sale_order_product_pricing.quotation_specialist_group,sales_team.group_sale_manager"
                           attrs="{'readonly': ['|', ('state', '!=', 'draft'),
                               ('can_assign_quotation_specialist', '=', False)]}"/>
                </xpath>

                <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="attributes">
                    <attribute name="optional">show</attribute>
                </xpath>

                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='discount']" position="after">
                    <field name="price_origin_label" string="Price Origin" readonly="1" optional="show"
                           help="Shows whether this price came from the Odoo Pricelist, Product Pricing, a manual edit, or historical data. Sales and Quotation Specialists may read it; only a Sales Manager certifies a historical origin. Review it before changing the commercial terms or applying a Standard Discount."/>
                </xpath>

                <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="before">
                    <field name="can_edit_quoted_price" invisible="1"/>
                </xpath>

                <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="attributes">
                    <attribute name="attrs">{'readonly': ['|', ('parent.state', '!=', 'draft'), ('can_edit_quoted_price', '=', False)]}</attribute>
                </xpath>

                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='discount']" position="before">
                    <field name="can_edit_pricelist_discount" invisible="1"/>
                </xpath>
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='discount']" position="attributes">
                    <attribute name="attrs">{'readonly': ['|', ('parent.state', '!=', 'draft'), ('can_edit_pricelist_discount', '=', False)]}</attribute>
                </xpath>
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='product_uom_qty']" position="attributes">
                    <attribute name="optional">show</attribute>
                </xpath>
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='product_uom']" position="attributes">
                    <attribute name="optional">show</attribute>
                </xpath>
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='price_unit']" position="attributes">
                    <attribute name="optional">show</attribute>
                </xpath>
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='tax_id']" position="attributes">
                    <attribute name="optional">show</attribute>
                </xpath>
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='discount']" position="attributes">
                    <attribute name="optional">show</attribute>
                </xpath>
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='price_subtotal']" position="attributes">
                    <attribute name="optional">show</attribute>
                </xpath>

                <xpath expr="//notebook/page[@name='customer_signature']" position="after">
                    <page string="Product Pricing" name="product_pricing"
                          groups="sale_order_product_pricing.product_pricing_group,sales_team.group_sale_manager">
                        <group>
                            <field name="product_pricing"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                        <group>
                            <group>
                                <field name="change_currency_rate_type" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="change_currency_rate" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="global_factor" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                            <group>
                                <field name="currency_estimate_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="currency_rate_estimate" readonly="1"/>
                                <field name="currency_rate_inverse" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <button name="action_preview_product_pricing" type="object" string="Preview Product Pricing"
                                    class="btn-secondary" attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('product_pricing', '=', False)]}"
                                    help="Product Pricing users calculate and explain proposed line prices without changing the quotation. Review the results, then use Confirm Apply only when every line is ready."/>
                        </group>
                        <!-- This is an input workspace over the same order lines, not a
                             second selling-price grid. It is hidden until Product Pricing
                             is enabled and never displays quoted prices or totals. -->
                        <field name="pricing_line_ids" nolabel="1"
                               attrs="{'invisible': [('product_pricing', '=', False)], 'readonly': [('state', '!=', 'draft')]}"
                               help="Restricted Product Pricing inputs. Enter the supplier estimate and factors here, then use Preview to review proposed selling prices before Apply.">
                            <tree editable="bottom" create="0" delete="0">
                                <field name="product_id" readonly="1"/>
                                <field name="product_uom_qty" string="Quantity" readonly="1"/>
                                <field name="purchase_price_estimate" string="Purchase Price Estimate"/>
                                <field name="factor" string="Global Factor"/>
                                <field name="line_factor" string="Line Factor"/>
                                <field name="pricing_eligible" readonly="1" optional="hide"/>
                                <field name="pricing_warning" readonly="1" optional="show"/>
                            </tree>
                        </field>
                        <group string="Price Origin Summary">
                            <field name="product_pricing_line_count" readonly="1"/>
                            <field name="odoo_pricelist_line_count" readonly="1"/>
                            <field name="edited_price_line_count" readonly="1"/>
                        </group>
                        <group string="Internal Margin">
                            <label for="margin"/>
                            <div class="text-nowrap">
                                <field name="margin" class="oe_inline" readonly="1"/>
                                <span class="oe_inline">
                                    (<field name="margin_percent" nolabel="1" class="oe_inline"
                                            widget="percentage" readonly="1"/>)
                                </span>
                            </div>
                        </group>
                        <field name="pricing_audit_log_ids" nolabel="1" readonly="1">
                            <tree create="0" edit="0" delete="0">
                                <field name="event_date"/>
                                <field name="user_id"/>
                                <field name="product_id"/>
                                <field name="old_price"/>
                                <field name="old_currency_id" optional="hide"/>
                                <field name="new_price"/>
                                <field name="new_currency_id" optional="hide"/>
                                <field name="old_origin"/>
                                <field name="new_origin"/>
                                <field name="reason"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="sale_order_universal_discount_security" model="ir.ui.view">
            <field name="name">sale.order.universal.discount.pricing.security</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="universal_discount.ks_discount_sale_order_form_inherited"/>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <field name="ks_enable_discount" position="after">
                    <field name="can_edit_quotation_price" invisible="1"/>
                </field>
                <field name="ks_enable_discount" position="attributes">
                    <attribute name="attrs">{'readonly': ['|', ('state', '!=', 'draft'),
                        ('can_edit_quotation_price', '=', False)]}</attribute>
                </field>
                <field name="ks_global_discount_type" position="attributes">
                    <attribute name="attrs">{'invisible': [('ks_enable_discount', '!=', True)],
                        'readonly': ['|', '|', ('ks_enable_discount', '!=', True),
                                     ('state', '!=', 'draft'),
                                     ('can_edit_quotation_price', '=', False)]}</attribute>
                </field>
                <field name="ks_global_discount_rate" position="attributes">
                    <attribute name="attrs">{'invisible': [('ks_enable_discount', '!=', True)],
                        'readonly': ['|', '|', ('ks_enable_discount', '!=', True),
                                     ('state', '!=', 'draft'),
                                     ('can_edit_quotation_price', '=', False)]}</attribute>
                </field>
                <xpath expr="//field[@name='order_line']//tree//field[@name='discount_2']" position="before">
                    <field name="can_edit_quoted_price" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='order_line']//tree//field[@name='discount_2']" position="attributes">
                    <attribute name="attrs">{'readonly': ['|', ('parent.state', '!=', 'draft'),
                        ('can_edit_quoted_price', '=', False)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']//tree//field[@name='discount_3']" position="attributes">
                    <attribute name="attrs">{'readonly': ['|', ('parent.state', '!=', 'draft'),
                        ('can_edit_quoted_price', '=', False)]}</attribute>
                </xpath>
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='discount_2']"
                       position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='discount_3']"
                       position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='discount']"
                       position="attributes">
                    <attribute name="string">Discount %</attribute>
                </xpath>
            </field>
        </record>

        <record id="sale_order_template_immutability" model="ir.ui.view">
            <field name="name">sale.order.template.immutability</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale_management.sale_order_form_quote"/>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <field name="sale_order_template_id" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </field>
                <field name="sale_order_option_ids" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', '!=', 'draft')]}</attribute>
                </field>
            </field>
        </record>
        <record id="sale_order_price_origin_reclassify_form" model="ir.ui.view">
            <field name="name">sale.order.price.origin.reclassify.form</field>
            <field name="model">sale.order.price.origin.reclassify</field>
            <field name="arch" type="xml">
                <form string="Certify Historical Price Origin">
                    <sheet>
                        <group>
                            <field name="line_id"/>
                            <field name="current_origin"/>
                            <field name="new_origin"/>
                            <field name="reason"
                                   placeholder="State the document, calculation, or business evidence used for this certification."/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_confirm" string="Certify Origin"
                                type="object" class="btn-primary"
                                help="Sales Managers save the reviewed historical-origin certification. It records the selected origin and evidence reason without repricing the line; return to the quotation and continue only after the evidence is complete."/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
