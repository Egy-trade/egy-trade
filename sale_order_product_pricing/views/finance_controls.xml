<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <!-- A compact quotation selector. It uses existing Finance-configured
         sales taxes; it neither creates accounting configuration nor posts. -->
    <record id="sale_order_finance_controls_form" model="ir.ui.view">
      <field name="name">sale.order.global.tax.selection.form</field>
      <field name="model">sale.order</field>
      <field name="inherit_id" ref="sale.view_order_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='payment_term_id']" position="after">
          <!-- This unrestricted invisible copy supplies the attrs dependency
               for every permitted form viewer. The editable selector below
               remains limited to Sales and Quotation Specialists. -->
          <field name="apply_vat" invisible="1"/>
          <group string="Taxes" col="4">
            <field name="apply_vat" string="VAT 14%"
                   groups="sales_team.group_sale_salesman,sale_order_product_pricing.quotation_specialist_group"
                   attrs="{'readonly': [('state', '!=', 'draft')]}"
                   help="Selected by default for QS and Sales users and applied globally to quotation lines through the configured existing tax. Clear only for a genuine VAT exemption, enter the reason below, and obtain Quotation Manager approval before Issue Offer PDF."/>
            <field name="apply_withholding" string="1% Withholding"
                   groups="sales_team.group_sale_salesman,sale_order_product_pricing.quotation_specialist_group"
                   attrs="{'readonly': [('state', '!=', 'draft')]}"
                   help="Optional 1% deduction from the proposed customer payment. Accounting remains standard Odoo when an invoice is later created."/>
          </group>
          <field name="vat_exemption_reason" string="VAT exemption reason"
                 placeholder="Why is this quotation VAT-exempt?"
                 attrs="{'invisible': [('apply_vat', '=', True)], 'readonly': [('state', '!=', 'draft')]}"/>
          <group attrs="{'invisible': [('apply_vat', '=', True)]}">
            <field name="vat_exemption_requested_by" readonly="1"/>
            <field name="vat_exemption_requested_at" readonly="1"/>
          </group>
          <field name="finance_approval_required" invisible="1"/>
          <field name="can_approve_quotation_requirements" invisible="1"/>
          <div class="alert alert-warning" role="alert"
               attrs="{'invisible': [('finance_approval_required', '=', False)]}">
            A quotation exception needs approval before Issue Offer PDF.
            <button name="action_approve_quotation_requirements" type="object"
                    string="Approve Quotation Requirements" class="btn-primary"
                    attrs="{'invisible': ['|', '|', ('finance_approval_required', '=', False), ('can_approve_quotation_requirements', '=', False), ('state', '!=', 'draft')]}"
                    help="Available to the configured eligible approver for the current exception. The server verifies authority for each requirement."/>
          </div>
          <field name="tax_selection_review_required" invisible="1"/>
          <div class="alert alert-warning" role="alert"
               attrs="{'invisible': [('tax_selection_review_required', '=', False)]}">
            This draft has a legacy or mixed tax selection. Review it before issuing an offer.
          </div>
        </xpath>
        <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='tax_id']" position="attributes">
          <attribute name="readonly">1</attribute>
          <attribute name="optional">show</attribute>
          <attribute name="help">Read-only. Choose VAT and withholding once in the quotation header.</attribute>
        </xpath>
        <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='price_unit']" position="after">
          <field name="is_free_of_charge" optional="hide"
                 help="Authorized zero-price exception. A Product Pricing user or Quotation/Sales Manager marks it and records the reason before Issue Offer PDF."/>
          <field name="free_of_charge_reason" optional="hide"
                 help="Explains why this line is offered at zero price; complete it before Issue Offer PDF."/>
        </xpath>
      </field>
    </record>

    <!-- Accounting owns the existing tax records. Sales management owns only
         the configurable high-value quotation gate. -->
    <record id="res_config_settings_finance_controls" model="ir.ui.view">
      <field name="name">res.config.settings.quotation.tax.configuration</field>
      <field name="model">res.config.settings</field>
      <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//div[@data-key='sale_management']/div[hasclass('o_settings_container')][2]" position="inside">
          <div class="col-12 col-lg-6 o_setting_box" groups="account.group_account_manager">
            <div class="o_setting_right_pane">
              <div class="o_form_label">Quotation Taxes</div>
              <div class="text-muted">Choose existing 14% VAT and negative 1% withholding sales taxes. This does not alter accounts, tags or accounting rules.</div>
              <field name="quotation_vat_tax_id"/>
              <field name="quotation_retention_tax_id"
                     help="Accounting Managers select the existing negative 1% withholding sales tax. It reduces the proposed customer payment when selected; configure it before Sales uses the global withholding selector."/>
            </div>
          </div>
          <div class="col-12 col-lg-6 o_setting_box"
               groups="sale_order_product_pricing.quotation_manager_group,sales_team.group_sale_manager,base.group_system">
            <div class="o_setting_right_pane">
              <div class="o_form_label">High-Value Quotation Approval</div>
              <div class="text-muted">Set the untaxed threshold in company currency and the group permitted to approve quotations at or above it. Set the threshold to zero to disable this gate.</div>
              <field name="quotation_high_value_threshold"/>
              <field name="quotation_high_value_approver_group_id"/>
            </div>
          </div>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
