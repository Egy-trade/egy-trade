<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="quotation_manager_group" model="res.groups">
      <field name="name">Quotation Manager</field>
      <field name="category_id" ref="base.module_category_sales_sales"/>
      <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="quotation_manager_finance_approval_rule" model="ir.rule">
      <field name="name">Quotation Managers: company finance approvals</field>
      <field name="model_id" ref="model_sale_order_finance_approval"/>
      <field name="groups" eval="[(4, ref('quotation_manager_group'))]"/>
      <field name="domain_force">[('order_id.company_id', 'in', company_ids)]</field>
      <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="sale_manager_finance_approval_rule" model="ir.rule">
      <field name="name">Sales Managers: company finance approvals</field>
      <field name="model_id" ref="model_sale_order_finance_approval"/>
      <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
      <field name="domain_force">[('order_id.company_id', 'in', company_ids)]</field>
      <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
  </data>
</odoo>
