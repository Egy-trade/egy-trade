<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quotation_commercial_change_view_form" model="ir.ui.view">
        <field name="name">quotation.commercial.change.form</field>
        <field name="model">quotation.commercial.change</field>
        <field name="arch" type="xml">
            <form string="Record Commercial Change">
                <sheet>
                    <group>
                        <field name="sale_id" invisible="1"/>
                        <field name="must_create_revision" invisible="1"/>
                        <field name="decision" widget="radio"
                               attrs="{'readonly': [('must_create_revision', '=', True)]}"
                               help="Choose how to handle the first commercial change in the Cairo business day. Issued offers must create a revision."/>
                        <field name="reason"
                               placeholder="Required for Create Revision; optional note for Update Today."
                               help="Explains why the commercial draft was refreshed or revised. The note is retained in the audit trail."/>
                    </group>
                    <div class="alert alert-warning" attrs="{'invisible': [('must_create_revision', '=', False)]}">
                        This offer has been issued. Its historical version is locked; create a revision.
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Continue" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
