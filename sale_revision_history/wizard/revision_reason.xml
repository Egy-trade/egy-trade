<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="revision_reason_view_form" model="ir.ui.view">
        <field name="name">revision.reason.form</field>
        <field name="model">revision.reason</field>
        <field name="arch" type="xml">
            <form string="Create Quotation Revision">
                <sheet>
                    <group>
                        <field name="sale_id" invisible="1"/>
                        <field name="name" placeholder="Explain what changed and why this revision is needed."/>
                    </group>
                </sheet>
                <footer>
                    <button string="Create Revision" name="action_confirm"
                            class="btn-primary" type="object"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
