<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_item_number_once" model="ir.ui.view">
        <field name="name">sale.order.item.number.once</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="egy-trade_custom.view_order_form_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree/field[@name='sn']" position="attributes">
                <attribute name="string">Item #</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="help">Optional item reference entered by the Quotation Specialist or assigned Sales user. It is never generated or renumbered, so enter the required reference or leave it blank before saving the draft.</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_order_revision_history_tree" model="ir.ui.view">
        <field name="name">sale.order.revision.history.tree</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <tree string="Quotation Revision History" create="0" edit="0" delete="0"
                  default_order="revision_number desc, revision_date desc, id desc">
                <field name="revision_number"/>
                <field name="name"/>
                <field name="revision_reason" string="Revision Comment"/>
                <field name="revision_date"/>
                <field name="revision_author_id"/>
                <field name="state"/>
                <field name="restored_from_revision_id" optional="hide"/>
                <field name="restoration_date" optional="hide"/>
                <field name="restoration_author_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="sale_order_revision_history_search" model="ir.ui.view">
        <field name="name">sale.order.revision.history.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Quotation Revision History">
                <field name="name"/>
                <field name="unrevisioned_name"/>
                <field name="revision_reason" string="Revision Comment"/>
                <field name="revision_author_id"/>
                <filter name="has_revision_comment" string="Has Revision Comment"
                        domain="[('revision_reason', '!=', False)]"/>
                <filter name="my_revision_comments" string="My Revision Comments"
                        domain="[('revision_author_id', '=', uid)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_revision_family" string="Revision Family"
                            context="{'group_by': 'unrevisioned_name'}"/>
                    <filter name="group_revision_author" string="Revision Author"
                            context="{'group_by': 'revision_author_id'}"/>
                    <filter name="group_revision_date" string="Revision Date"
                            context="{'group_by': 'revision_date:day'}"/>
                    <filter name="group_revision_number" string="Revision Number"
                            context="{'group_by': 'revision_number'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.form.revision.history</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//form/header/button[@name='action_cancel'])[1]" position="after">
                <button name="action_record_commercial_change" type="object"
                        string="Record Commercial Change" class="btn-secondary"
                        attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('active', '=', False)]}"
                        help="Before the first commercial save in a Cairo business day, choose Update Today or Create Revision. This is required for draft prices, quantities, terms, and lines."/>
                <button name="action_issue_offer_pdf" type="object"
                        string="Issue Offer PDF" class="btn-primary"
                        confirm="Issue and lock this exact customer Offer PDF? Changes afterwards require a revision. If Sales responsibility is unaccepted, issuing still proceeds but records the exception and notifies Sales and Sales Managers."
                        attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('active', '=', False)]}"
                        help="Assigned Sales or QS, or quotation/sales management, issues the customer Offer PDF. It attaches the exact version, records actor and time, then marks the offer Sent and locks it; review the confirmation and create a revision for any later change."/>
                <button name="action_accept_sales_responsibility" type="object"
                        string="Accept Sales Responsibility" class="btn-secondary"
                        attrs="{'invisible': ['|', '|', ('state', '!=', 'draft'), ('active', '=', False), ('sales_responsibility_accepted', '=', True)]}"
                        help="Assigned Sales or a Sales Manager confirms responsibility for this draft. Issuing may still proceed without acceptance, but it is recorded and notified."/>
                <button name="action_revision" type="object" string="Create Revision"
                        groups="sales_team.group_sale_salesman"
                        attrs="{'invisible': ['|', '|', ('state', '!=', 'sent'), ('active', '=', False), ('current_revision_id', '!=', False)]}"
                        help="Assigned Sales or QS, or a Sales Manager, creates the next draft from this issued version with a mandatory reason; the issued source remains locked."/>
            </xpath>
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']/tree" position="inside">
                <button name="action_add_below" type="object" string="Add Below" icon="fa-plus"
                        attrs="{'invisible': ['|', '|', ('display_type', '!=', False), ('product_id', '=', False), ('parent.state', '!=', 'draft')]}"
                        help="Creates one blank product row immediately below this product line. Only the quotation Global Factor is inherited; no product, quantities, Item #, prices, costs, discounts, or Line Factor are copied."/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Revisions" name="revision_history">
                    <group>
                        <field name="unrevisioned_name" readonly="1"/>
                        <field name="revision_number" readonly="1"/>
                        <field name="current_revision_id" invisible="1"/>
                        <field name="restored_from_revision_id" readonly="1"/>
                        <field name="restoration_reason" readonly="1"/>
                        <field name="restoration_date" readonly="1"/>
                        <field name="restoration_author_id" readonly="1"/>
                        <field name="restoration_difference_summary" readonly="1"/>
                        <field name="commercial_change_date" readonly="1"/>
                        <field name="commercial_change_decision" readonly="1"/>
                        <field name="commercial_change_decision_at" readonly="1"/>
                        <field name="commercial_change_decision_by" readonly="1"/>
                        <field name="commercial_change_audit" readonly="1"/>
                        <field name="issued_offer_attachment_id" readonly="1"/>
                        <field name="issued_offer_at" readonly="1"/>
                        <field name="issued_offer_by" readonly="1"/>
                        <field name="issued_offer_version" readonly="1"/>
                        <field name="issued_offer_audit" readonly="1"/>
                        <field name="sales_responsibility_accepted" readonly="1"/>
                        <field name="sales_responsibility_accepted_at" readonly="1"/>
                        <field name="sales_responsibility_accepted_by" readonly="1"/>
                        <field name="issued_without_sales_acceptance" readonly="1"/>
                        <field name="active" invisible="1"/>
                        <button name="action_open_revision_history" type="object"
                                string="Open Revision History" class="oe_link"
                                help="Open only this quotation family, newest revision first. Unrelated quotation families are excluded."/>
                        <button name="action_restore_historical_revision" type="object"
                                string="Create Next Revision from This Version" class="oe_link"
                                groups="sales_team.group_sale_salesman"
                                help="Copy a previously sent quotation in this family into a new N+1 draft. Historical sent offers are never reopened or changed."/>
                    </group>
                    <field name="old_revision_ids" nolabel="1" readonly="1">
                        <tree create="0" edit="0" delete="0"
                              default_order="revision_number desc, revision_date desc, id desc">
                            <field name="revision_number"/>
                            <field name="name"/>
                            <field name="revision_reason" string="Revision Comment"/>
                            <field name="revision_date"/>
                            <field name="revision_author_id"/>
                            <field name="state"/>
                            <field name="restored_from_revision_id" optional="hide"/>
                            <field name="restoration_date" optional="hide"/>
                            <field name="restoration_author_id" optional="hide"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
