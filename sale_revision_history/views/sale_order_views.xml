<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_revision_history_tree" model="ir.ui.view">
        <field name="name">sale.order.revision.history.tree</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <tree string="Quotation Revision History" create="0" edit="0" delete="0"
                  default_order="revision_number desc, revision_date desc, id desc">
                <field name="revision_number"/>
                <field name="name"/>
                <field name="revision_reason" string="Revision Comment"/>
                <field name="revision_date"/>
                <field name="revision_author_id"/>
                <field name="state"/>
                <field name="restored_from_revision_id" optional="hide"/>
                <field name="restoration_date" optional="hide"/>
                <field name="restoration_author_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="sale_order_revision_history_search" model="ir.ui.view">
        <field name="name">sale.order.revision.history.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search string="Quotation Revision History">
                <field name="name"/>
                <field name="unrevisioned_name"/>
                <field name="revision_reason" string="Revision Comment"/>
                <field name="revision_author_id"/>
                <filter name="has_revision_comment" string="Has Revision Comment"
                        domain="[('revision_reason', '!=', False)]"/>
                <filter name="my_revision_comments" string="My Revision Comments"
                        domain="[('revision_author_id', '=', uid)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_revision_family" string="Revision Family"
                            context="{'group_by': 'unrevisioned_name'}"/>
                    <filter name="group_revision_author" string="Revision Author"
                            context="{'group_by': 'revision_author_id'}"/>
                    <filter name="group_revision_date" string="Revision Date"
                            context="{'group_by': 'revision_date:day'}"/>
                    <filter name="group_revision_number" string="Revision Number"
                            context="{'group_by': 'revision_number'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.form.revision.history</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//form/header/button[@name='action_cancel'])[1]" position="after">
                <button name="action_revision" type="object" string="Create Revision"
                        groups="sales_team.group_sale_salesman"
                        attrs="{'invisible': ['|', '|', ('state', '!=', 'sent'), ('active', '=', False), ('current_revision_id', '!=', False)]}"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Revisions" name="revision_history">
                    <group>
                        <field name="unrevisioned_name" readonly="1"/>
                        <field name="revision_number" readonly="1"/>
                        <field name="current_revision_id" invisible="1"/>
                        <field name="restored_from_revision_id" readonly="1"/>
                        <field name="restoration_reason" readonly="1"/>
                        <field name="restoration_date" readonly="1"/>
                        <field name="restoration_author_id" readonly="1"/>
                        <field name="restoration_difference_summary" readonly="1"/>
                        <field name="active" invisible="1"/>
                        <button name="action_open_revision_history" type="object"
                                string="Open Revision History" class="oe_link"/>
                        <button name="action_restore_historical_revision" type="object"
                                string="Create Next Revision from This Version" class="oe_link"
                                groups="sales_team.group_sale_salesman"
                                help="Copy a previously sent quotation in this family into a new N+1 draft. Historical sent offers are never reopened or changed."/>
                    </group>
                    <field name="old_revision_ids" nolabel="1" readonly="1">
                        <tree create="0" edit="0" delete="0"
                              default_order="revision_number desc, revision_date desc, id desc">
                            <field name="revision_number"/>
                            <field name="name"/>
                            <field name="revision_reason" string="Revision Comment"/>
                            <field name="revision_date"/>
                            <field name="revision_author_id"/>
                            <field name="state"/>
                            <field name="restored_from_revision_id" optional="hide"/>
                            <field name="restoration_date" optional="hide"/>
                            <field name="restoration_author_id" optional="hide"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
